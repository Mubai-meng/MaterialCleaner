<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="@string/storage_redirect_title"
        android:title="@string/storage_redirect_title"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/aggressively_prompt_for_reading_media_files_key"
            android:summary="@string/aggressively_prompt_for_reading_media_files_summary"
            android:title="@string/aggressively_prompt_for_reading_media_files_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/open_wizard_by_default_key"
            android:title="@string/open_wizard_by_default_title"
            app:iconSpaceReserved="false" />

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="files"
            android:entries="@array/wizard_root_dir_entries"
            android:entryValues="@array/wizard_root_dir_values"
            android:key="@string/wizard_root_dir_name_key"
            android:summary="%s"
            android:title="@string/wizard_root_dir_name_title"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/share_key"
            android:title="@string/share_title"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/import_key"
            android:title="@string/import_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/apply_template_on_package_added_key"
            android:title="@string/apply_template_on_package_added_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/auto_logging_key"
            android:title="@string/auto_logging_title"
            android:summary="@string/auto_logging_summary"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/advanced_header"
        app:iconSpaceReserved="false">

        <me.gm.cleaner.settings.PathListPreference
            android:key="@string/edit_read_only_template_key"
            android:title="@string/edit_read_only_template_title"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/apply_read_only_template_to_key"
            android:title="@string/apply_read_only_template_to_title"
            app:iconSpaceReserved="false" />

        <me.gm.cleaner.client.ui.EditMountRulesTemplatePreference
            android:key="@string/edit_mount_rules_template_key"
            android:title="@string/edit_mount_rules_template_title"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/apply_mount_rules_template_to_key"
            android:title="@string/apply_mount_rules_template_to_title"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/filesystem_record_title"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="@string/record_shared_storage_key"
            android:title="@string/record_shared_storage_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:dependency="@string/record_shared_storage_key"
            android:key="@string/record_external_app_specific_storage_key"
            android:summary="@string/record_external_app_specific_storage_summary"
            android:title="@string/record_external_app_specific_storage_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/upsert_key"
            android:summary="@string/upsert_summary"
            android:title="@string/upsert_title"
            app:iconSpaceReserved="false" />

        <!--
          媒体库写入审计总开关（第52批）。
          默认关闭 ⇒ 与历史行为完全一致（未命中重定向规则时 InsertHooker 静默）。
          打开后每次 insert 留一条 MC_REDIRECT 审计流水，按包 10s 节流。
          只观测、不拦截：打开它不会改变任何应用的写入结果。

          刻意**不加** android:dependency：审计与「记录文件系统」是两件独立的事
          （前者看 MediaStore 建条目，后者看 FUSE 文件事件），且用户常常只想
          临时开审计排查问题，不想连带打开记录带来的性能损失。

          只存在于 v30 变体：InsertHooker 在 SDK_INT < Q 直接 return，
          对 res/xml 服务的 API 26–29 设备无实际功能。
        -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/audit_media_insert_key"
            android:summary="@string/audit_media_insert_summary"
            android:title="@string/audit_media_insert_title"
            app:iconSpaceReserved="false" />

        <!--
          媒体库写入拒绝总开关（第52批）。
          默认关闭 ⇒ 与历史行为完全一致（命中规则也照样放行）。
          打开后命中「不可访问」或「只读」规则的 insert 被短路拒绝。

          刻意**不**与审计开关做 dependency：两者独立 ——
          审计是"看得见"，拒绝是"拦得住"，用户可能只想先开审计摸清情况。

          只存在于 v30 变体：InsertHooker 在 SDK_INT < Q 直接 return，
          对 res/xml 服务的 API 26–29 设备无实际功能。
        -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/deny_media_insert_writes_key"
            android:summary="@string/deny_media_insert_writes_summary"
            android:title="@string/deny_media_insert_writes_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/service_and_notification_header">
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_outline_start_24"
            android:key="@string/start_on_boot_key"
            android:summary="@string/start_on_boot_summary"
            android:title="@string/start_on_boot_title" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_outline_update_24"
            android:key="@string/post_notification_key"
            android:title="@string/post_notification_title" />

        <Preference
            android:icon="@drawable/ic_outline_update_24"
            android:key="@string/check_update_key"
            android:summary="@string/check_update_summary"
            android:title="@string/check_update_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/language_header">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:entries="@array/language"
            android:entryValues="@array/language_value"
            android:icon="@drawable/ic_outline_translate_24"
            android:key="@string/language_key"
            android:summary="%s"
            android:title="@string/language_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/theme_header">

        <me.gm.cleaner.settings.theme.ThemeColorPreference
            android:defaultValue=""
            android:dependency="@string/theme_m3_key"
            android:dialogTitle="@string/theme_color_title"
            android:icon="@drawable/ic_outline_palette_24"
            android:key="@string/theme_color_key"
            android:summary="@string/theme_color_summary"
            android:title="@string/theme_color_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:disableDependentsState="true"
            android:icon="@drawable/outline_format_paint_24"
            android:key="@string/theme_m3_key"
            android:title="@string/theme_m3_title" />

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="MODE_NIGHT_FOLLOW_SYSTEM"
            android:entries="@array/theme_texts"
            android:entryValues="@array/theme_values"
            android:icon="@drawable/ic_outline_dark_mode_24"
            android:key="@string/dark_theme_key"
            android:summary="%s"
            android:title="@string/dark_theme_title" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_outline_contrast_24"
            android:key="@string/black_dark_theme_key"
            android:title="@string/black_dark_theme_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about_header">
        <Preference
            android:icon="@drawable/ic_baseline_info_24"
            android:key="@string/about_key"
            android:summary="@string/about_summary"
            android:title="@string/about_title" />
    </PreferenceCategory>

    <!--
        用户要求放在设置页最下面。语义是「让本模块自己在系统桌面/后台消失」，
        不是隐藏别的应用 —— 见 SelfHidingPreferences 的类文档。

        注意：本文件是 res/xml-v30 变体，Android 11(API 30)+ 设备**只加载这一份**，
        res/xml/service_more_options_preferences.xml 仅在 API<30 生效。
        两份必须保持「本模块」分类一致 —— 5.5.13 只改了 res/xml 版本，
        导致实机上这两个开关根本不渲染（第47批实证）。守卫见
        SelfHidingPreferenceVariantParityTest。
    -->
    <PreferenceCategory
        android:title="@string/self_hiding_header"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/hide_desktop_icon_key"
            android:summary="@string/hide_desktop_icon_summary"
            android:title="@string/hide_desktop_icon_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/hide_recents_key"
            android:summary="@string/hide_recents_summary"
            android:title="@string/hide_recents_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
